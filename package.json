{
  "name": "cleanstack-generator",
  "version": "0.1.0",
  "description": "A clean, maintainable Angular and Spring Boot project generator.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "cleanstack": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/core/config.d.ts",
      "default": "./dist/core/config.js"
    },
    "./config-loader": {
      "types": "./dist/core/config-loader.d.ts",
      "default": "./dist/core/config-loader.js"
    },
    "./templates": {
      "types": "./dist/templates/template-engine.d.ts",
      "default": "./dist/templates/template-engine.js"
    },
    "./filesystem": {
      "types": "./dist/utils/file-system.d.ts",
      "default": "./dist/utils/file-system.js"
    },
    "./logger": {
      "types": "./dist/utils/logger.d.ts",
      "default": "./dist/utils/logger.js"
    },
    "./path-safety": {
      "types": "./dist/utils/path-safety.d.ts",
      "default": "./dist/utils/path-safety.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "start": "npm run build && node dist/cli/index.js hello",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "generator",
    "scaffold",
    "angular",
    "spring-boot",
    "typescript",
    "cli"
  ],
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "dependencies": {
    "handlebars": "^4.7.10",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  }
}
