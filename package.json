{
  "name": "cleanstack-generator",
  "version": "0.1.0",
  "description": "A clean, maintainable Angular and Spring Boot project generator.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamuelAlehegn/CleanStack.git"
  },
  "bugs": {
    "url": "https://github.com/SamuelAlehegn/CleanStack/issues"
  },
  "homepage": "https://github.com/SamuelAlehegn/CleanStack#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "cleanstack": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/core/config.d.ts",
      "default": "./dist/core/config.js"
    },
    "./config-loader": {
      "types": "./dist/core/config-loader.d.ts",
      "default": "./dist/core/config-loader.js"
    },
    "./entity-parser": {
      "types": "./dist/core/entity-parser.d.ts",
      "default": "./dist/core/entity-parser.js"
    },
    "./migrations": {
      "types": "./dist/core/migrations.d.ts",
      "default": "./dist/core/migrations.js"
    },
    "./openapi-client": {
      "types": "./dist/core/openapi-client.d.ts",
      "default": "./dist/core/openapi-client.js"
    },
    "./templates": {
      "types": "./dist/templates/template-engine.d.ts",
      "default": "./dist/templates/template-engine.js"
    },
    "./filesystem": {
      "types": "./dist/utils/file-system.d.ts",
      "default": "./dist/utils/file-system.js"
    },
    "./logger": {
      "types": "./dist/utils/logger.d.ts",
      "default": "./dist/utils/logger.js"
    },
    "./path-safety": {
      "types": "./dist/utils/path-safety.d.ts",
      "default": "./dist/utils/path-safety.js"
    },
    "./protected-regions": {
      "types": "./dist/core/protected-regions.d.ts",
      "default": "./dist/core/protected-regions.js"
    },
    "./protected-region-manager": {
      "types": "./dist/core/protected-region-manager.d.ts",
      "default": "./dist/core/protected-region-manager.js"
    },
    "./sql-types": {
      "types": "./dist/core/sql-types.d.ts",
      "default": "./dist/core/sql-types.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "templates",
    "web/dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test",
    "test:e2e": "npm run build && node --test tests/e2e.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ui": "npm run build && npm run ui:build && node dist/cli/index.js ui",
    "ui:static": "npm run build && npm run ui:build && node dist/cli/index.js ui --static",
    "ui:dev": "tsx src/cli/index.ts ui --dev",
    "ui:build": "vite build --config web/vite.config.ts",
    "ui:check": "tsc -p web/tsconfig.json",
    "start": "npm run build && node dist/cli/index.js hello",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "commitlint": "commitlint",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "prepare": "husky",
    "prepublishOnly": "npm run build && npm run ui:build"
  },
  "keywords": [
    "generator",
    "scaffold",
    "angular",
    "spring-boot",
    "typescript",
    "cli"
  ],
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.5",
    "commander": "^15.0.0",
    "fflate": "^0.8.3",
    "handlebars": "^4.7.10",
    "ora": "^9.4.1",
    "picocolors": "^1.1.1",
    "tsx": "^4.23.15",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
