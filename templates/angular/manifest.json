{
  "name": "angular",
  "description": "A minimal Angular 22 standalone application with a page-first structure, signals, and routing.",
  "files": [
    { "template": "root/package.json.hbs", "destination": "package.json" },
    { "template": "root/angular.json.hbs", "destination": "angular.json" },
    { "template": "root/tsconfig.json.hbs", "destination": "tsconfig.json" },
    { "template": "root/tsconfig.app.json.hbs", "destination": "tsconfig.app.json" },
    { "template": "root/.gitignore.hbs", "destination": ".gitignore" },
    { "template": "root/README.md.hbs", "destination": "README.md" },
    { "template": "src/index.html.hbs", "destination": "src/index.html" },
    { "template": "src/main.ts.hbs", "destination": "src/main.ts" },
    { "template": "src/styles.scss.hbs", "destination": "src/styles.scss" },
    {
      "template": "src/environments/environment.ts.hbs",
      "destination": "src/environments/environment.ts"
    },
    {
      "template": "src/environments/environment.development.ts.hbs",
      "destination": "src/environments/environment.development.ts"
    },
    { "template": "src/proxy.conf.json.hbs", "destination": "src/proxy.conf.json" },
    {
      "template": "src/app/core/auth/JwtAuthService.ts.hbs",
      "destination": "src/app/core/auth/auth.service.ts",
      "when": { "auth": "jwt" }
    },
    {
      "template": "src/app/core/auth/SessionAuthService.ts.hbs",
      "destination": "src/app/core/auth/auth.service.ts",
      "when": { "auth": "session" }
    },
    {
      "template": "src/app/core/auth/OidcAuthService.ts.hbs",
      "destination": "src/app/core/auth/auth.service.ts",
      "when": { "auth": ["oidc", "keycloak", "auth0"] }
    },
    {
      "template": "src/app/core/auth/AuthGuard.ts.hbs",
      "destination": "src/app/core/auth/auth.guard.ts",
      "when": { "auth": ["jwt", "session", "oidc", "keycloak", "auth0"] }
    },
    {
      "template": "src/app/core/auth/JwtAuthInterceptor.ts.hbs",
      "destination": "src/app/core/auth/auth.interceptor.ts",
      "when": { "auth": "jwt" }
    },
    {
      "template": "src/app/core/auth/SessionAuthInterceptor.ts.hbs",
      "destination": "src/app/core/auth/auth.interceptor.ts",
      "when": { "auth": "session" }
    },
    {
      "template": "src/app/pages/auth/login/LoginComponent.ts.hbs",
      "destination": "src/app/pages/auth/login/login.component.ts",
      "when": { "auth": ["jwt", "session", "oidc", "keycloak", "auth0"] }
    },
    {
      "template": "src/app/pages/auth/login/LoginComponent.html.hbs",
      "destination": "src/app/pages/auth/login/login.component.html",
      "when": { "auth": ["jwt", "session", "oidc", "keycloak", "auth0"] }
    },
    {
      "template": "src/app/pages/auth/login/LoginComponent.scss.hbs",
      "destination": "src/app/pages/auth/login/login.component.scss",
      "when": { "auth": ["jwt", "session", "oidc", "keycloak", "auth0"] }
    },
    {
      "template": "src/app/pages/auth/profile/ProfileComponent.ts.hbs",
      "destination": "src/app/pages/auth/profile/profile.component.ts",
      "when": { "auth": ["jwt", "session", "oidc", "keycloak", "auth0"] }
    },
    {
      "template": "src/app/pages/auth/profile/ProfileComponent.html.hbs",
      "destination": "src/app/pages/auth/profile/profile.component.html",
      "when": { "auth": ["jwt", "session", "oidc", "keycloak", "auth0"] }
    },
    {
      "template": "src/app/pages/auth/profile/ProfileComponent.scss.hbs",
      "destination": "src/app/pages/auth/profile/profile.component.scss",
      "when": { "auth": ["jwt", "session", "oidc", "keycloak", "auth0"] }
    },
    { "template": "src/app/app.config.ts.hbs", "destination": "src/app/app.config.ts" },
    { "template": "src/app/app.routes.ts.hbs", "destination": "src/app/app.routes.ts" },
    {
      "template": "src/app/app.component.ts.hbs",
      "destination": "src/app/app.component.ts"
    },
    {
      "template": "src/app/app.component.html.hbs",
      "destination": "src/app/app.component.html"
    },
    {
      "template": "src/app/app.component.scss.hbs",
      "destination": "src/app/app.component.scss"
    },
    {
      "template": "src/app/app.component.spec.ts.hbs",
      "destination": "src/app/app.component.spec.ts"
    },
    {
      "template": "src/app/layout/app-layout/app-layout.component.ts.hbs",
      "destination": "src/app/layout/app-layout/app-layout.component.ts"
    },
    {
      "template": "src/app/layout/app-layout/app-layout.component.html.hbs",
      "destination": "src/app/layout/app-layout/app-layout.component.html"
    },
    {
      "template": "src/app/layout/app-layout/app-layout.component.scss.hbs",
      "destination": "src/app/layout/app-layout/app-layout.component.scss"
    },
    {
      "template": "src/app/pages/home/home.component.ts.hbs",
      "destination": "src/app/pages/home/home.component.ts"
    },
    {
      "template": "src/app/pages/home/home.component.html.hbs",
      "destination": "src/app/pages/home/home.component.html"
    },
    {
      "template": "src/app/pages/home/home.component.scss.hbs",
      "destination": "src/app/pages/home/home.component.scss"
    },
    {
      "template": "src/app/pages/settings/settings.component.ts.hbs",
      "destination": "src/app/pages/settings/settings.component.ts"
    },
    {
      "template": "src/app/pages/settings/settings.component.html.hbs",
      "destination": "src/app/pages/settings/settings.component.html"
    },
    {
      "template": "src/app/pages/settings/settings.component.scss.hbs",
      "destination": "src/app/pages/settings/settings.component.scss"
    },
    { "template": "src/app/core/README.md.hbs", "destination": "src/app/core/README.md" },
    {
      "template": "src/app/directives/README.md.hbs",
      "destination": "src/app/directives/README.md"
    },
    { "template": "src/app/guards/README.md.hbs", "destination": "src/app/guards/README.md" },
    {
      "template": "src/app/interceptors/README.md.hbs",
      "destination": "src/app/interceptors/README.md"
    },
    { "template": "src/app/shared/README.md.hbs", "destination": "src/app/shared/README.md" },
    { "template": "src/app/models/README.md.hbs", "destination": "src/app/models/README.md" },
    {
      "template": "src/app/services/README.md.hbs",
      "destination": "src/app/services/README.md"
    },
    {
      "template": "src/app/api/README.md.hbs",
      "destination": "src/app/api/README.md"
    },
    {
      "template": "src/app/api/generated/.gitkeep.hbs",
      "destination": "src/app/api/generated/.gitkeep"
    },
    {
      "template": "src/app/models/Entity.ts.hbs",
      "destination": "src/app/models/{{entity.variableName}}.ts",
      "forEach": "entities"
    },
    {
      "template": "src/app/services/EntityService.ts.hbs",
      "destination": "src/app/services/{{entity.variableName}}.service.ts",
      "forEach": "entities"
    },
    {
      "template": "src/app/pages/entity/list/EntityListComponent.ts.hbs",
      "destination": "src/app/pages/{{entity.routeName}}/list/list.component.ts",
      "forEach": "entities"
    },
    {
      "template": "src/app/pages/entity/list/EntityListComponent.html.hbs",
      "destination": "src/app/pages/{{entity.routeName}}/list/list.component.html",
      "forEach": "entities"
    },
    {
      "template": "src/app/pages/entity/list/EntityListComponent.scss.hbs",
      "destination": "src/app/pages/{{entity.routeName}}/list/list.component.scss",
      "forEach": "entities"
    },
    {
      "template": "src/app/pages/entity/detail/EntityDetailComponent.ts.hbs",
      "destination": "src/app/pages/{{entity.routeName}}/detail/detail.component.ts",
      "forEach": "entities"
    },
    {
      "template": "src/app/pages/entity/detail/EntityDetailComponent.html.hbs",
      "destination": "src/app/pages/{{entity.routeName}}/detail/detail.component.html",
      "forEach": "entities"
    },
    {
      "template": "src/app/pages/entity/detail/EntityDetailComponent.scss.hbs",
      "destination": "src/app/pages/{{entity.routeName}}/detail/detail.component.scss",
      "forEach": "entities"
    },
    {
      "template": "src/app/pages/entity/form/EntityFormComponent.ts.hbs",
      "destination": "src/app/pages/{{entity.routeName}}/form/form.component.ts",
      "forEach": "entities"
    },
    {
      "template": "src/app/pages/entity/form/EntityFormComponent.html.hbs",
      "destination": "src/app/pages/{{entity.routeName}}/form/form.component.html",
      "forEach": "entities"
    },
    {
      "template": "src/app/pages/entity/form/EntityFormComponent.scss.hbs",
      "destination": "src/app/pages/{{entity.routeName}}/form/form.component.scss",
      "forEach": "entities"
    }
  ]
}
