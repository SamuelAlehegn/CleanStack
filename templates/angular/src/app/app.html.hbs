<div class="app-frame">
  <aside class="sidebar" [class.sidebar-open]="menuOpen()">
    <a class="brand" routerLink="/" (click)="closeMenu()" aria-label="Go to overview">
      <span class="brand-mark" aria-hidden="true">C</span>
      <span class="brand-name">{{pascalCase project.name}}</span>
    </a>

    <div class="nav-label">Workspace</div>
    <nav class="primary-nav" aria-label="Primary navigation">
      <a routerLink="/" routerLinkActive="nav-link-active" [routerLinkActiveOptions]="{ exact: true }" (click)="closeMenu()">
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><rect x="3" y="3" width="5" height="5" rx="1.3"/><rect x="12" y="3" width="5" height="5" rx="1.3"/><rect x="3" y="12" width="5" height="5" rx="1.3"/><rect x="12" y="12" width="5" height="5" rx="1.3"/></svg>
        <span>Overview</span>
      </a>
      <a routerLink="/settings" routerLinkActive="nav-link-active" (click)="closeMenu()">
        <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><circle cx="10" cy="10" r="3"/><path d="M16.2 11.8a6.7 6.7 0 0 0 0-3.6l1.2-1-1.5-2.6-1.5.5a6.5 6.5 0 0 0-3.1-1.8L11 1.8H8l-.3 1.5a6.5 6.5 0 0 0-3.1 1.8l-1.5-.5-1.5 2.6 1.2 1a6.7 6.7 0 0 0 0 3.6l-1.2 1 1.5 2.6 1.5-.5a6.5 6.5 0 0 0 3.1 1.8l.3 1.5h3l.3-1.5a6.5 6.5 0 0 0 3.1-1.8l1.5.5 1.5-2.6-1.2-1Z"/></svg>
        <span>Settings</span>
      </a>
    </nav>

    <div class="sidebar-bottom">
      <div class="workspace-card">
        <span class="workspace-avatar" aria-hidden="true">{{capitalize (pascalCase project.name)}}</span>
        <span class="workspace-copy"><strong>{{pascalCase project.name}}</strong><small>Starter workspace</small></span>
        <span class="workspace-menu" aria-hidden="true">···</span>
      </div>
      <span class="version-label">Angular 22 · Standalone</span>
    </div>
  </aside>

  <div class="main-column">
    <header class="topbar">
      <button class="mobile-menu" type="button" (click)="toggleMenu()" [attr.aria-expanded]="menuOpen()" aria-label="Toggle navigation">
        <span></span><span></span><span></span>
      </button>
      <div class="breadcrumb"><span>Workspace</span><span class="breadcrumb-divider">/</span><strong>Overview</strong></div>
      <div class="topbar-actions">
        <span class="status-pill"><span class="status-dot"></span>All systems normal</span>
        <button class="avatar-button" type="button" aria-label="Account menu">{{capitalize (pascalCase project.name)}}</button>
      </div>
    </header>

    <main class="page-content">
      <router-outlet />
    </main>
  </div>
</div>

@if (menuOpen()) {
  <button class="mobile-scrim" type="button" (click)="closeMenu()" aria-label="Close navigation"></button>
}
