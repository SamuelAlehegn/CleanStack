import type { Routes } from '@angular/router';

import { AppLayoutComponent } from './layout/app-layout/app-layout.component';
{{#unless (eq project.options.auth "none")}}
import { authGuard } from './core/auth/auth.guard';
{{/unless}}

export const routes: Routes = [
{{#unless (eq project.options.auth "none")}}
  {
    path: 'login',
    title: 'Sign in',
    loadComponent: () =>
      import('./pages/auth/login/login.component').then((module) => module.LoginComponent),
  },
{{/unless}}
  {
    path: '',
    component: AppLayoutComponent,
{{#unless (eq project.options.auth "none")}}
    canActivate: [authGuard],
{{/unless}}
    children: [
      {
        path: '',
        title: 'Overview',
        loadComponent: () =>
          import('./pages/home/home.component').then((module) => module.HomeComponent),
      },
      {
        path: 'settings',
        title: 'Settings',
        loadComponent: () =>
          import('./pages/settings/settings.component').then(
            (module) => module.SettingsComponent,
          ),
      },
{{#unless (eq project.options.auth "none")}}
      {
        path: 'profile',
        title: 'Profile',
        loadComponent: () =>
          import('./pages/auth/profile/profile.component').then(
            (module) => module.ProfileComponent,
          ),
      },
{{/unless}}
      // <cleanstack:user-code id="routes.custom">
      // </cleanstack:user-code>
      // <cleanstack:entity-routes>
{{#each entities}}
      {
        path: '{{routeName}}',
        title: '{{pluralName}}',
        loadComponent: () =>
          import('./pages/{{routeName}}/list/list.component').then(
            (module) => module.{{className}}ListComponent,
          ),
      },
      {
        path: '{{routeName}}/new',
        title: 'New {{name}}',
        loadComponent: () =>
          import('./pages/{{routeName}}/form/form.component').then(
            (module) => module.{{className}}FormComponent,
          ),
      },
      {
        path: '{{routeName}}/:id',
        title: '{{name}} details',
        loadComponent: () =>
          import('./pages/{{routeName}}/detail/detail.component').then(
            (module) => module.{{className}}DetailComponent,
          ),
      },
      {
        path: '{{routeName}}/:id/edit',
        title: 'Edit {{name}}',
        loadComponent: () =>
          import('./pages/{{routeName}}/form/form.component').then(
            (module) => module.{{className}}FormComponent,
          ),
      },
{{/each}}
      // </cleanstack:entity-routes>
    ],
  },
  { path: '**', redirectTo: '' },
];
