:host {
  display: block;
}

.page-heading,
.card-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
}

.eyebrow {
  margin: 0 0 8px;
  color: var(--muted);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

h1,
h2,
p {
  margin-top: 0;
}

h1 {
  margin-bottom: 7px;
  font-size: clamp(25px, 3vw, 32px);
  font-weight: 680;
  letter-spacing: -0.045em;
  line-height: 1.15;
}

.page-description {
  margin-bottom: 0;
  color: var(--muted);
  font-size: 13px;
}

.primary-button {
  display: inline-flex;
  min-height: 38px;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 0 13px;
  border: 1px solid var(--accent);
  border-radius: 8px;
  background: var(--accent);
  box-shadow: 0 1px 2px rgb(28 25 80 / 12%);
  color: #fff;
  font-size: 11px;
  font-weight: 600;
  text-decoration: none;
  transition: background 150ms ease, transform 150ms ease;
}

.primary-button:hover {
  transform: translateY(-1px);
  background: #4b43aa;
}

.primary-button span {
  font-size: 17px;
  font-weight: 400;
}

.welcome-card {
  position: relative;
  display: flex;
  min-height: 272px;
  align-items: center;
  justify-content: space-between;
  overflow: hidden;
  margin-top: 28px;
  padding: 34px 42px;
  border: 1px solid #e8e7f2;
  border-radius: 15px;
  background: linear-gradient(112deg, #f3f2ff 0%, #f8f8ff 53%, #f4f4fb 100%);
}

.welcome-copy {
  position: relative;
  z-index: 1;
  max-width: 430px;
}

.welcome-kicker {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: #5c54ad;
  font-size: 10px;
  font-weight: 650;
}

.welcome-sparkle {
  font-size: 14px;
}

.welcome-copy h2 {
  margin: 14px 0 10px;
  color: #25243c;
  font-size: clamp(25px, 3vw, 34px);
  font-weight: 670;
  letter-spacing: -0.05em;
  line-height: 1.1;
}

.welcome-copy h2 span {
  color: #7772aa;
}

.welcome-copy p {
  max-width: 390px;
  margin-bottom: 17px;
  color: #707188;
  font-size: 12px;
  line-height: 1.7;
}

.text-link,
.subtle-link {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: var(--accent);
  font-size: 11px;
  font-weight: 650;
  text-decoration: none;
}

.text-link:hover,
.subtle-link:hover {
  text-decoration: underline;
}

.welcome-art {
  position: absolute;
  top: 50%;
  right: 7%;
  width: 260px;
  height: 230px;
  transform: translateY(-50%);
}

.art-orbit {
  position: absolute;
  top: 50%;
  left: 50%;
  border: 1px solid rgb(115 107 190 / 17%);
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.orbit-one {
  width: 105px;
  height: 105px;
}

.orbit-two {
  width: 165px;
  height: 165px;
}

.orbit-three {
  width: 226px;
  height: 226px;
}

.art-core {
  position: absolute;
  top: 50%;
  left: 50%;
  display: flex;
  width: 62px;
  height: 62px;
  align-items: center;
  justify-content: center;
  gap: 4px;
  border: 1px solid rgb(255 255 255 / 80%);
  border-radius: 20px;
  background: linear-gradient(145deg, #8f89dc, #625bb7);
  box-shadow: 0 13px 35px rgb(89 82 168 / 25%);
  transform: translate(-50%, -50%) rotate(-8deg);
}

.art-core span {
  width: 5px;
  height: 20px;
  border-radius: 4px;
  background: #fff;
  opacity: 0.9;
}

.art-core span:nth-child(2) {
  height: 28px;
  opacity: 1;
}

.art-core span:nth-child(3) {
  height: 13px;
  opacity: 0.7;
}

.art-node {
  position: absolute;
  width: 11px;
  height: 11px;
  border: 3px solid #f4f3ff;
  border-radius: 50%;
  background: #8c85d5;
  box-shadow: 0 1px 7px rgb(80 73 160 / 18%);
}

.node-one {
  top: 17px;
  left: 127px;
}

.node-two {
  right: 13px;
  bottom: 63px;
  width: 15px;
  height: 15px;
  background: #a9a3e1;
}

.node-three {
  bottom: 26px;
  left: 54px;
  width: 8px;
  height: 8px;
  background: #c2bdec;
}

.overview-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) minmax(300px, 0.8fr);
  gap: 16px;
  margin-top: 18px;
}

.surface-card {
  min-width: 0;
  padding: 22px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--surface);
  box-shadow: 0 2px 5px rgb(22 29 46 / 2%);
}

.card-heading {
  align-items: flex-start;
}

.card-heading .eyebrow {
  margin-bottom: 5px;
}

.card-heading h2 {
  margin-bottom: 0;
  font-size: 14px;
  font-weight: 650;
  letter-spacing: -0.025em;
}

.progress-count {
  padding: 5px 8px;
  border-radius: 6px;
  background: #f4f3fd;
  color: #5d56a9;
  font-size: 10px;
  font-weight: 650;
  white-space: nowrap;
}

.progress-track {
  height: 5px;
  overflow: hidden;
  margin: 19px 0 9px;
  border-radius: 5px;
  background: #edeef2;
}

.progress-track span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #746ec4, #928cdb);
  transition: width 180ms ease;
}

.setup-list,
.stack-list {
  display: grid;
}

.setup-row {
  display: flex;
  min-height: 68px;
  align-items: center;
  gap: 11px;
  border-bottom: 1px solid #f0f1f4;
  cursor: pointer;
}

.setup-row:last-child {
  border-bottom: 0;
}

.setup-row input {
  width: 15px;
  height: 15px;
  accent-color: #716bc0;
  cursor: pointer;
}

.setup-copy,
.stack-copy {
  display: grid;
  min-width: 0;
  gap: 4px;
}

.setup-copy strong,
.stack-copy strong {
  color: var(--ink);
  font-size: 11px;
  font-weight: 620;
}

.setup-copy small,
.stack-copy small {
  color: var(--muted);
  font-size: 10px;
}

.setup-row-complete .setup-copy strong {
  color: #858997;
  text-decoration: line-through;
  text-decoration-color: #c5c8cf;
}

.row-arrow {
  margin-left: auto;
  color: #b0b4be;
  font-size: 14px;
}

.empty-state {
  margin: 16px 0 4px;
  color: var(--muted);
  font-size: 11px;
}

.spark-icon {
  display: grid;
  width: 27px;
  height: 27px;
  place-items: center;
  border-radius: 8px;
  background: #f2f0ff;
  color: #6e67b9;
  font-size: 15px;
}

.stack-list {
  gap: 14px;
  margin: 21px 0 16px;
}

.stack-row {
  display: flex;
  align-items: center;
  gap: 10px;
}

.stack-icon {
  display: grid;
  width: 30px;
  height: 30px;
  flex: 0 0 auto;
  place-items: center;
  border-radius: 9px;
  font-size: 12px;
  font-weight: 750;
}

.angular-icon {
  background: #fff0f1;
  color: #d54c64;
}

.signal-icon {
  background: #f1f0ff;
  color: #6b65bf;
  font-size: 19px;
}

.api-icon {
  background: #eaf7f2;
  color: #3e9a77;
}

.stack-state {
  margin-left: auto;
  color: #328969;
  font-size: 10px;
  font-weight: 600;
}

.stack-state-muted {
  color: #9297a3;
}

.subtle-link {
  padding-top: 13px;
  border-top: 1px solid #f0f1f4;
  color: var(--muted-strong);
  font-size: 10px;
}

.bottom-note {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-top: 18px;
  padding: 14px 16px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: rgb(255 255 255 / 60%);
}

.note-icon {
  display: grid;
  width: 28px;
  height: 28px;
  flex: 0 0 auto;
  place-items: center;
  border-radius: 8px;
  background: #f2f0ff;
  color: #6e67b9;
  font-size: 15px;
}

.bottom-note p {
  margin: 0;
  color: var(--muted);
  font-size: 10px;
  line-height: 1.6;
}

.bottom-note strong {
  color: var(--muted-strong);
}

.bottom-note code {
  padding: 1px 4px;
  border-radius: 4px;
  background: #f0f1f5;
  color: #666d7d;
  font-family: var(--mono);
  font-size: 9px;
}

@media (max-width: 980px) {
  .welcome-art {
    right: 2%;
    opacity: 0.55;
  }

  .overview-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 620px) {
  .page-heading {
    align-items: flex-start;
    flex-direction: column;
  }

  .welcome-card {
    min-height: 280px;
    padding: 26px 22px;
  }

  .welcome-art {
    top: auto;
    right: -45px;
    bottom: -55px;
    transform: scale(0.8);
    opacity: 0.22;
  }

  .surface-card {
    padding: 18px;
  }

  .bottom-note {
    align-items: flex-start;
  }
}
