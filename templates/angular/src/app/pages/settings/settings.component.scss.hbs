:host {
  display: block;
}

.page-heading {
  margin-bottom: 26px;
}

.eyebrow {
  margin: 0 0 8px;
  color: var(--muted);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

h1 {
  margin: 0 0 7px;
  font-size: clamp(25px, 3vw, 32px);
  font-weight: 680;
  letter-spacing: -0.045em;
}

.page-description {
  margin: 0;
  color: var(--muted);
  font-size: 13px;
}

.settings-card {
  display: flex;
  max-width: 680px;
  align-items: flex-start;
  gap: 15px;
  padding: 22px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--surface);
}

.settings-icon {
  display: grid;
  width: 34px;
  height: 34px;
  flex: 0 0 auto;
  place-items: center;
  border-radius: 9px;
  background: #f2f0ff;
  color: #6e67b9;
  font-size: 17px;
}

.settings-card h2 {
  margin: 1px 0 7px;
  font-size: 13px;
  font-weight: 650;
}

.settings-card p {
  max-width: 530px;
  margin: 0;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.7;
}
