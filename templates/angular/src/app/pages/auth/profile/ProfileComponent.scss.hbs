:host {
  display: block;
}

.page-heading {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 20px;
}

.eyebrow {
  margin: 0 0 8px;
  color: var(--muted);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

h1 {
  margin: 0 0 7px;
  font-size: clamp(25px, 3vw, 32px);
  font-weight: 680;
  letter-spacing: -0.045em;
  line-height: 1.15;
}

.page-description {
  margin: 0;
  color: var(--muted);
  font-size: 13px;
}

.secondary-button {
  display: inline-flex;
  min-height: 38px;
  align-items: center;
  padding: 0 13px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: var(--surface);
  color: var(--muted-strong);
  font-size: 11px;
  font-weight: 600;
  cursor: pointer;
  transition: border-color 150ms ease, color 150ms ease;
}

.secondary-button:hover {
  border-color: #d9d7e8;
  color: var(--ink);
}

.profile-card {
  display: flex;
  align-items: flex-start;
  gap: 20px;
  margin-top: 28px;
  padding: 26px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--surface);
}

.avatar {
  display: grid;
  width: 64px;
  height: 64px;
  flex: 0 0 auto;
  place-items: center;
  border-radius: 18px;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 20px;
  font-weight: 750;
}

.profile-copy h2 {
  margin: 2px 0 5px;
  font-size: 20px;
  font-weight: 680;
  letter-spacing: -0.03em;
}

.email {
  margin: 0;
  color: var(--muted);
  font-size: 12px;
}

.profile-meta {
  display: grid;
  gap: 14px;
  margin: 22px 0 0;
}

.profile-meta div {
  display: grid;
  gap: 5px;
}

.profile-meta dt {
  color: var(--muted);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.profile-meta dd {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
  margin: 0;
  color: var(--muted-strong);
  font-size: 12px;
}

.role-chip {
  display: inline-flex;
  align-items: center;
  padding: 3px 8px;
  border: 1px solid #e5e2f6;
  border-radius: 999px;
  background: #faf9ff;
  color: #5f57ad;
  font-size: 10px;
  font-weight: 600;
}

.muted {
  color: var(--muted);
}

.empty-state {
  margin: 0;
  color: var(--muted);
  font-size: 13px;
}

