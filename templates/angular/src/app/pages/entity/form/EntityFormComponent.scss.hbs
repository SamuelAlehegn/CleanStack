:host {
  display: block;
}

.eyebrow {
  margin: 0 0 8px;
  color: var(--muted);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

h1,
p {
  margin-top: 0;
}

h1 {
  margin-bottom: 7px;
  font-size: clamp(25px, 3vw, 32px);
  font-weight: 680;
  letter-spacing: -0.045em;
  line-height: 1.15;
}

.page-description {
  margin-bottom: 0;
  color: var(--muted);
  font-size: 13px;
}

.form-card {
  display: grid;
  gap: 18px;
  max-width: 680px;
  margin-top: 28px;
  padding: 24px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: var(--surface);
  box-shadow: 0 2px 5px rgb(22 29 46 / 2%);
}

.field {
  display: grid;
  gap: 7px;
}

.field-label {
  color: var(--muted-strong);
  font-size: 11px;
  font-weight: 600;
}

.required {
  color: #b05d5d;
}

.field input[type='text'],
.field input[type='number'],
.field input[type='date'],
.field input[type='time'],
.field input[type='datetime-local'] {
  width: 100%;
  min-height: 38px;
  padding: 0 11px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fff;
  color: var(--ink);
  font-size: 13px;
}

.field input:hover {
  border-color: #d9dce3;
}

.field input:focus {
  border-color: var(--accent);
}

.checkbox-field {
  display: flex;
  align-items: center;
  gap: 9px;
  color: var(--muted-strong);
  cursor: pointer;
  font-size: 12px;
  font-weight: 600;
}

.checkbox-field input {
  width: 15px;
  height: 15px;
  accent-color: var(--accent);
}

.field-error,
.form-error {
  color: #9b4b4b;
  font-size: 11px;
}

.form-error {
  margin: 0;
  padding: 10px 12px;
  border: 1px solid #f0d8d8;
  border-radius: 8px;
  background: #fffafa;
}

.form-actions {
  display: flex;
  align-items: center;
  gap: 9px;
  padding-top: 4px;
}

.primary-button,
.secondary-button {
  min-height: 38px;
  padding: 0 15px;
  border-radius: 8px;
  cursor: pointer;
  font-size: 12px;
  font-weight: 600;
}

.primary-button {
  border: 1px solid var(--accent);
  background: var(--accent);
  color: #fff;
}

.primary-button:hover:not(:disabled) {
  background: #4b43aa;
}

.primary-button:disabled {
  cursor: default;
  opacity: 0.6;
}

.secondary-button {
  border: 1px solid var(--line);
  background: var(--surface);
  color: var(--muted-strong);
}

.secondary-button:hover {
  background: #fafafc;
}

@media (max-width: 620px) {
  .form-card {
    padding: 18px;
  }
}
