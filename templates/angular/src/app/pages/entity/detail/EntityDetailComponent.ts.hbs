import { Component, inject, signal } from '@angular/core';
import { ActivatedRoute, Router, RouterLink } from '@angular/router';

import type { {{entity.className}} } from '../../../models/{{entity.variableName}}';
import { {{entity.className}}Service } from '../../../services/{{entity.variableName}}.service';

@Component({
  selector: 'app-{{entity.routeName}}-detail',
  imports: [RouterLink],
  templateUrl: './detail.component.html',
  styleUrl: './detail.component.scss',
})
export class {{entity.className}}DetailComponent {
  private readonly route = inject(ActivatedRoute);
  private readonly router = inject(Router);
  private readonly service = inject({{entity.className}}Service);

  readonly selected = signal<{{entity.className}} | null>(null);
  readonly loading = signal(true);
  readonly error = signal<string | null>(null);

  constructor() {
    this.load(this.route.snapshot.paramMap.get('id') ?? '');
  }

  load(id: string): void {
    this.loading.set(true);
    this.error.set(null);

    this.service.get(id).subscribe({
      next: ({{entity.variableName}}) => {
        this.selected.set({{entity.variableName}});
        this.loading.set(false);
      },
      error: () => {
        this.error.set('Unable to load this {{lowercase entity.name}}.');
        this.loading.set(false);
      },
    });
  }

  remove(): void {
    const item = this.selected();

    if (!item || !confirm('Delete this {{lowercase entity.name}}?')) {
      return;
    }

    this.service.remove(item.id).subscribe({
      next: () => this.router.navigate(['/{{entity.routeName}}']),
      error: () =>
        this.error.set('Unable to delete this {{lowercase entity.name}}. Please try again.'),
    });
  }
}
