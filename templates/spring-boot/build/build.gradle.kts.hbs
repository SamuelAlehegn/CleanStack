plugins {
    java
    id("org.springframework.boot") version "4.1.2"
}

group = "{{project.packageName}}"
version = "0.0.1-SNAPSHOT"

java {
    toolchain {
        languageVersion = JavaLanguageVersion.of(21)
    }
}

repositories {
    mavenCentral()
}

dependencies {
    implementation(platform("org.springframework.boot:spring-boot-dependencies:4.1.2"))

    implementation("org.springframework.boot:spring-boot-starter-webmvc")
    implementation("org.springframework.boot:spring-boot-starter-validation")
    implementation("org.springframework.boot:spring-boot-starter-data-jpa")
    implementation("org.springframework.boot:spring-boot-starter-actuator")
    implementation("org.springframework.boot:spring-boot-starter-flyway")
{{#if (eq project.options.auth "jwt")}}
    implementation("org.springframework.boot:spring-boot-starter-oauth2-resource-server")
{{/if}}
{{#if (eq project.options.auth "keycloak")}}
    implementation("org.springframework.boot:spring-boot-starter-oauth2-resource-server")
{{/if}}
{{#if (eq project.options.database "postgresql")}}

    runtimeOnly("org.postgresql:postgresql")
    runtimeOnly("org.flywaydb:flyway-database-postgresql")
{{/if}}
{{#if (eq project.options.database "mysql")}}

    runtimeOnly("com.mysql:mysql-connector-j")
    runtimeOnly("org.flywaydb:flyway-mysql")
{{/if}}
{{#if (eq project.options.database "h2")}}

    runtimeOnly("com.h2database:h2")
    runtimeOnly("org.springframework.boot:spring-boot-h2console")
{{/if}}

    testImplementation("org.springframework.boot:spring-boot-starter-test")
    testRuntimeOnly("org.junit.platform:junit-platform-launcher")
}

tasks.withType<Test> {
    useJUnitPlatform()
}
