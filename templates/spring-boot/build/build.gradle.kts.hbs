plugins {
    java
    id("org.springframework.boot") version "{{toolchain.springBoot.version}}"
}

group = "{{project.packageName}}"
version = "0.0.1-SNAPSHOT"

java {
    toolchain {
        languageVersion = JavaLanguageVersion.of({{toolchain.java.version}})
    }
}

repositories {
    mavenCentral()
}

dependencies {
    implementation(platform("org.springframework.boot:spring-boot-dependencies:{{toolchain.springBoot.version}}"))

    implementation("org.springframework.boot:spring-boot-starter-{{#if (eq toolchain.springBoot.line "3.5")}}web{{else}}webmvc{{/if}}")
    implementation("org.springframework.boot:spring-boot-starter-validation")
    implementation("org.springframework.boot:spring-boot-starter-data-jpa")
    implementation("org.springframework.boot:spring-boot-starter-actuator")
{{#if (eq project.options.migrationTool "liquibase")}}
    implementation("org.liquibase:liquibase-core")
{{else}}
{{#if (eq toolchain.springBoot.line "3.5")}}
    implementation("org.flywaydb:flyway-core")
{{else}}
    implementation("org.springframework.boot:spring-boot-starter-flyway")
{{/if}}
{{/if}}
    implementation("org.springdoc:springdoc-openapi-starter-webmvc-ui:{{#if (eq toolchain.springBoot.line "3.5")}}2.8.13{{else}}3.2.0{{/if}}")
{{#if (or (eq project.options.auth "jwt") (eq project.options.auth "oidc") (eq project.options.auth "keycloak") (eq project.options.auth "auth0"))}}
    implementation("org.springframework.boot:spring-boot-starter-oauth2-resource-server")
{{/if}}
{{#if (eq project.options.auth "session")}}
    implementation("org.springframework.boot:spring-boot-starter-security")
{{/if}}
{{#if (eq project.options.database "postgresql")}}

    runtimeOnly("org.postgresql:postgresql")
{{#if (eq project.options.migrationTool "flyway")}}
    runtimeOnly("org.flywaydb:flyway-database-postgresql")
{{/if}}
{{/if}}
{{#if (eq project.options.database "mysql")}}

    runtimeOnly("com.mysql:mysql-connector-j")
{{#if (eq project.options.migrationTool "flyway")}}
    runtimeOnly("org.flywaydb:flyway-mysql")
{{/if}}
{{/if}}
{{#if (eq project.options.database "h2")}}

    runtimeOnly("com.h2database:h2")
{{#unless (eq toolchain.springBoot.line "3.5")}}
    runtimeOnly("org.springframework.boot:spring-boot-h2console")
{{/unless}}
{{/if}}

    testImplementation("org.springframework.boot:spring-boot-starter-test")
    testRuntimeOnly("org.junit.platform:junit-platform-launcher")
}

tasks.withType<Test> {
    useJUnitPlatform()
}

