{
  "name": "spring-boot",
  "description": "Spring Boot service skeleton using a simple layered package structure.",
  "pathVariables": {
    "package": "The configured Java package name with dots replaced by path separators.",
    "ApplicationName": "The project name converted to PascalCase."
  },
  "files": [
    { "template": "build/pom.xml.hbs", "destination": "pom.xml", "when": { "buildTool": "maven" } },
    {
      "template": "build/mvnw.hbs",
      "destination": "mvnw",
      "when": { "buildTool": "maven" },
      "executable": true
    },
    {
      "template": "build/mvnw.cmd.hbs",
      "destination": "mvnw.cmd",
      "when": { "buildTool": "maven" }
    },
    {
      "template": "build/maven-wrapper.properties.hbs",
      "destination": ".mvn/wrapper/maven-wrapper.properties",
      "when": { "buildTool": "maven" }
    },
    { "template": "build/build.gradle.kts.hbs", "destination": "build.gradle.kts", "when": { "buildTool": "gradle" } },
    { "template": "build/settings.gradle.kts.hbs", "destination": "settings.gradle.kts", "when": { "buildTool": "gradle" } },
    { "template": "root/.gitignore.hbs", "destination": ".gitignore" },
    { "template": "root/README.md.hbs", "destination": "README.md" },
    { "template": "root/ARCHITECTURE.md.hbs", "destination": "ARCHITECTURE.md" },
    { "template": "docker/Dockerfile.maven.hbs", "destination": "Dockerfile", "when": { "docker": true, "buildTool": "maven" } },
    { "template": "docker/Dockerfile.gradle.hbs", "destination": "Dockerfile", "when": { "docker": true, "buildTool": "gradle" } },
    { "template": "docker/.dockerignore.hbs", "destination": ".dockerignore", "when": { "docker": true } },
    { "template": "docker/docker-compose.yml.hbs", "destination": "docker-compose.yml", "when": { "docker": true } },
    { "template": "resources/application.yml.hbs", "destination": "src/main/resources/application.yml" },
    { "template": "resources/application-dev.yml.hbs", "destination": "src/main/resources/application-dev.yml" },
    { "template": "resources/db/migration/V1__baseline.sql.hbs", "destination": "src/main/resources/db/migration/V1__baseline.sql", "when": { "migrationTool": "flyway" } },
    { "template": "resources/db/changelog/db.changelog-master.xml.hbs", "destination": "src/main/resources/db/changelog/db.changelog-master.xml", "when": { "migrationTool": "liquibase" } },
    { "template": "resources/db/changelog/changes/V1__baseline.xml.hbs", "destination": "src/main/resources/db/changelog/changes/V1__baseline.xml", "when": { "migrationTool": "liquibase" } },
    { "template": "resources/db/migration/CreateTable.sql.hbs", "destination": "src/main/resources/db/migration/V{{migration.version}}__create_{{entity.tableName}}_table.sql", "internal": true },
    { "template": "resources/db/migration/UpdateTable.sql.hbs", "destination": "src/main/resources/db/migration/V{{migration.version}}__update_{{entity.tableName}}_{{migration.changeSlug}}.sql", "internal": true },
    { "template": "resources/db/migration/SeedData.sql.hbs", "destination": "src/main/resources/db/migration/V{{migration.version}}__seed_{{entity.tableName}}.sql", "internal": true },
    { "template": "resources/db/changelog/changes/CreateTable.xml.hbs", "destination": "src/main/resources/db/changelog/changes/V{{migration.version}}__create_{{entity.tableName}}_table.xml", "internal": true },
    { "template": "resources/db/changelog/changes/UpdateTable.xml.hbs", "destination": "src/main/resources/db/changelog/changes/V{{migration.version}}__update_{{entity.tableName}}_{{migration.changeSlug}}.xml", "internal": true },
    { "template": "resources/db/changelog/changes/SeedData.xml.hbs", "destination": "src/main/resources/db/changelog/changes/V{{migration.version}}__seed_{{entity.tableName}}.xml", "internal": true },
    { "template": "java/Application.java.hbs", "destination": "src/main/java/{{package}}/{{ApplicationName}}Application.java" },
    { "template": "java/ApplicationTests.java.hbs", "destination": "src/test/java/{{package}}/{{ApplicationName}}Tests.java" },
    { "template": "java/domain/package-info.java.hbs", "destination": "src/main/java/{{package}}/domain/package-info.java" },
    { "template": "java/domain/Greeting.java.hbs", "destination": "src/main/java/{{package}}/domain/Greeting.java" },
    { "template": "java/domain/Entity.java.hbs", "destination": "src/main/java/{{package}}/domain/{{entity.className}}.java", "forEach": "entities" },
    { "template": "java/application/package-info.java.hbs", "destination": "src/main/java/{{package}}/service/package-info.java" },
    { "template": "java/application/GreetUseCase.java.hbs", "destination": "src/main/java/{{package}}/service/GreetUseCase.java" },
    { "template": "java/application/GreetingService.java.hbs", "destination": "src/main/java/{{package}}/service/GreetingService.java" },
    { "template": "java/application/EntityService.java.hbs", "destination": "src/main/java/{{package}}/service/{{entity.className}}Service.java", "forEach": "entities" },
    { "template": "java/application/EntityRepository.java.hbs", "destination": "src/main/java/{{package}}/repository/{{entity.className}}Repository.java", "forEach": "entities" },
    { "template": "java/application/EntityNotFoundException.java.hbs", "destination": "src/main/java/{{package}}/exception/{{entity.className}}NotFoundException.java", "forEach": "entities" },
    { "template": "java/infrastructure/config/package-info.java.hbs", "destination": "src/main/java/{{package}}/config/package-info.java" },
    { "template": "java/infrastructure/config/ApplicationConfig.java.hbs", "destination": "src/main/java/{{package}}/config/ApplicationConfig.java" },
    { "template": "java/infrastructure/config/OpenApiConfig.java.hbs", "destination": "src/main/java/{{package}}/config/OpenApiConfig.java" },
    { "template": "java/infrastructure/security/package-info.java.hbs", "destination": "src/main/java/{{package}}/security/package-info.java" },
    { "template": "java/infrastructure/security/SecurityConfig.java.hbs", "destination": "src/main/java/{{package}}/security/SecurityConfig.java", "when": { "auth": "jwt" } },
    { "template": "java/infrastructure/security/SecurityConfig.java.hbs", "destination": "src/main/java/{{package}}/security/SecurityConfig.java", "when": { "auth": "keycloak" } },
    { "template": "java/infrastructure/web/package-info.java.hbs", "destination": "src/main/java/{{package}}/controller/package-info.java" },
    { "template": "java/infrastructure/web/GreetingController.java.hbs", "destination": "src/main/java/{{package}}/controller/GreetingController.java" },
    { "template": "java/infrastructure/web/EntityController.java.hbs", "destination": "src/main/java/{{package}}/controller/{{entity.className}}Controller.java", "forEach": "entities" },
    { "template": "java/infrastructure/web/GreetingResponse.java.hbs", "destination": "src/main/java/{{package}}/web/dto/GreetingResponse.java" },
    { "template": "java/infrastructure/web/EntityRequest.java.hbs", "destination": "src/main/java/{{package}}/web/dto/{{entity.className}}Request.java", "forEach": "entities" },
    { "template": "java/infrastructure/web/EntityResponse.java.hbs", "destination": "src/main/java/{{package}}/web/dto/{{entity.className}}Response.java", "forEach": "entities" },
    { "template": "java/infrastructure/web/EntityMapper.java.hbs", "destination": "src/main/java/{{package}}/web/mapper/{{entity.className}}Mapper.java", "forEach": "entities" },
    { "template": "java/exception/package-info.java.hbs", "destination": "src/main/java/{{package}}/exception/package-info.java" },
    { "template": "java/web/dto/package-info.java.hbs", "destination": "src/main/java/{{package}}/web/dto/package-info.java" },
    { "template": "java/web/mapper/package-info.java.hbs", "destination": "src/main/java/{{package}}/web/mapper/package-info.java" }
  ]
}
