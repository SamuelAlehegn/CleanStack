package {{project.packageName}}.application;

import {{project.packageName}}.domain.Greeting;
import java.time.Clock;
import java.time.LocalTime;
import java.time.format.DateTimeFormatter;
import java.util.Locale;

/** Default implementation of {@link GreetUseCase}. */
public final class GreetingService implements GreetUseCase {

    private static final DateTimeFormatter TIME_FORMAT =
            DateTimeFormatter.ofPattern("HH:mm:ss", Locale.ROOT);

    private final Clock clock;

    public GreetingService(Clock clock) {
        this.clock = clock;
    }

    @Override
    public Greeting greet(String name) {
        var recipient = name == null || name.isBlank() ? "world" : name.strip();
        var time = TIME_FORMAT.format(LocalTime.now(clock));
        return new Greeting("Hello, %s! The time is %s.".formatted(recipient, time));
    }
}
