package {{project.packageName}}.config;

import {{project.packageName}}.service.GreetUseCase;
import {{project.packageName}}.service.GreetingService;
import java.time.Clock;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;

/**
 * Shared application configuration.
 */
@Configuration(proxyBeanMethods = false)
public class ApplicationConfig {

    @Bean
    GreetUseCase greetUseCase(Clock clock) {
        return new GreetingService(clock);
    }
    @Bean
    Clock clock() {
        return Clock.systemDefaultZone();
    }
}
