spring:
  jpa:
    show-sql: true
    properties:
      hibernate:
        format_sql: true
{{#if (eq project.options.database "h2")}}
  h2:
    console:
      enabled: true
      path: /h2-console
{{/if}}

logging:
  level:
    {{project.packageName}}: DEBUG
    org.hibernate.SQL: DEBUG
    org.hibernate.orm.jdbc.bind: TRACE
