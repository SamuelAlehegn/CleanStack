spring:
  application:
    name: {{kebabCase project.name}}
  threads:
    virtual:
      enabled: true
  datasource:
{{#if (eq project.options.database "postgresql")}}
    url: jdbc:postgresql://localhost:5432/{{snakeCase project.name}}
    username: postgres
    password: postgres
{{/if}}
{{#if (eq project.options.database "mysql")}}
    url: jdbc:mysql://localhost:3306/{{snakeCase project.name}}
    username: root
    password: root
{{/if}}
{{#if (eq project.options.database "h2")}}
    url: "jdbc:h2:mem:{{snakeCase project.name}};MODE=PostgreSQL;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE"
    username: sa
    password: ""
{{/if}}
  jpa:
    open-in-view: false
    hibernate:
      ddl-auto: validate
    properties:
      hibernate:
        jdbc:
          time_zone: UTC
{{#if (eq project.options.migrationTool "liquibase")}}
  liquibase:
    enabled: true
    change-log: classpath:db/changelog/db.changelog-master.xml
{{else}}
  flyway:
    enabled: true
    locations: classpath:db/migration
{{/if}}
{{#if (eq project.options.auth "jwt")}}
  security:
    oauth2:
      resourceserver:
        jwt:
          issuer-uri: ${JWT_ISSUER_URI:http://localhost:9000}
{{/if}}
{{#if (eq project.options.auth "keycloak")}}
  security:
    oauth2:
      resourceserver:
        jwt:
          issuer-uri: ${KEYCLOAK_ISSUER_URI:http://localhost:8081/realms/cleanstack}
{{/if}}
{{#if (eq project.options.auth "auth0")}}
  security:
    oauth2:
      resourceserver:
        jwt:
          issuer-uri: ${AUTH0_ISSUER_URI:https://YOUR_DOMAIN.auth0.com/}
{{/if}}
{{#if (eq project.options.auth "oidc")}}
  security:
    oauth2:
      resourceserver:
        jwt:
          issuer-uri: ${OIDC_ISSUER_URI:https://issuer.example.com}
{{/if}}
{{#if (eq project.options.auth "session")}}
  security:
    user:
      name: ${APP_SECURITY_USERNAME:demo}
      password: ${APP_SECURITY_PASSWORD:demo}
{{/if}}
  lifecycle:
    timeout-per-shutdown-phase: 20s

server:
  port: ${SERVER_PORT:8080}
  shutdown: graceful
{{#if (eq project.options.auth "session")}}
  servlet:
    session:
      timeout: 30m
      cookie:
        http-only: true
        same-site: lax
{{/if}}

management:
  endpoints:
    web:
      exposure:
        include: health,info
  endpoint:
    health:
      probes:
        enabled: true

springdoc:
  api-docs:
    path: /v3/api-docs
  swagger-ui:
    path: /swagger-ui.html
    operations-sorter: method

